{
  "name": "@flowkit/nodes-builtin",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "flowkit-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./ssrf": {
      "flowkit-source": "./src/ssrf.ts",
      "types": "./dist/ssrf.d.ts",
      "default": "./dist/ssrf.js"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./ssrf": {
        "types": "./dist/ssrf.d.ts",
        "default": "./dist/ssrf.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsup",
    "manifest:playground": "UPDATE_PLAYGROUND_MANIFEST=1 vitest run src/playground-manifest.test.ts && biome format --write ../react/playground/builtin-manifest.json"
  },
  "dependencies": {
    "@flowkit/core": "workspace:*"
  },
  "peerDependencies": {
    "zod": "^4"
  },
  "devDependencies": {
    "vitest": "5.0.0",
    "zod": "4.6.5"
  }
}
