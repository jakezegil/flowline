{
  "name": "@flowline/nodes-builtin",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "description": "Built-in Flowline nodes: conditionals, switch, forEach, stop, delay, waitForCallback, httpRequest, transform, callSubflow and triggers.",
  "keywords": [
    "workflow",
    "automation",
    "workflow-builder",
    "workflow-nodes"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jakezegil/flowline.git",
    "directory": "packages/nodes-builtin"
  },
  "homepage": "https://github.com/jakezegil/flowline/tree/main/packages/nodes-builtin#readme",
  "bugs": "https://github.com/jakezegil/flowline/issues",
  "engines": {
    "node": ">=20.18.1"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "flowline-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./ssrf": {
      "flowline-source": "./src/ssrf.ts",
      "types": "./dist/ssrf.d.ts",
      "default": "./dist/ssrf.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./ssrf": {
        "types": "./dist/ssrf.d.ts",
        "default": "./dist/ssrf.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsup",
    "manifest:playground": "UPDATE_PLAYGROUND_MANIFEST=1 vitest run src/playground-manifest.test.ts && biome format --write ../react/playground/builtin-manifest.json"
  },
  "dependencies": {
    "@flowline/core": "workspace:^"
  },
  "peerDependencies": {
    "zod": "^4"
  },
  "devDependencies": {
    "vitest": "5.0.0",
    "zod": "4.6.5"
  }
}
