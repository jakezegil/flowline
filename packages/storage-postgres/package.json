{
  "name": "@flowlinejs/storage-postgres",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "description": "Postgres StorageAdapter for the Flowline engine, with idempotent migrations and worker-safe run claiming via SKIP LOCKED.",
  "keywords": [
    "workflow",
    "automation",
    "workflow-builder",
    "storage",
    "postgres"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jakezegil/flowline.git",
    "directory": "packages/storage-postgres"
  },
  "homepage": "https://github.com/jakezegil/flowline/tree/main/packages/storage-postgres#readme",
  "bugs": "https://github.com/jakezegil/flowline/issues",
  "engines": {
    "node": ">=20.18.1"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "flowline-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "flowline-source": "./src/testing.ts",
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./testing": {
        "types": "./dist/testing.d.ts",
        "default": "./dist/testing.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsup"
  },
  "dependencies": {
    "@flowlinejs/core": "workspace:^",
    "@flowlinejs/engine": "workspace:^"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@types/pg": "8.23.1",
    "pg": "8.23.0",
    "vitest": "5.0.0",
    "zod": "4.6.5"
  },
  "peerDependencies": {
    "zod": "^4"
  }
}
