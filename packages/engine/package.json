{
  "name": "@flowkit/engine",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "description": "Durable workflow engine for Flowkit: interprets workflow documents over a pluggable StorageAdapter, with retries, suspension, schedules and an audit trail.",
  "keywords": [
    "workflow",
    "automation",
    "workflow-engine",
    "workflow-builder",
    "durable-execution"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jakezegil/flowkit.git",
    "directory": "packages/engine"
  },
  "homepage": "https://github.com/jakezegil/flowkit/tree/main/packages/engine#readme",
  "bugs": "https://github.com/jakezegil/flowkit/issues",
  "engines": {
    "node": ">=20.3.0"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "flowkit-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "flowkit-source": "./src/testing/index.ts",
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./testing": {
        "types": "./dist/testing/index.d.ts",
        "default": "./dist/testing/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsup"
  },
  "dependencies": {
    "@flowkit/core": "workspace:^",
    "@flowkit/nodes-builtin": "workspace:^",
    "cron-parser": "5.10.1",
    "quickjs-emscripten": "0.32.0",
    "undici": "7.29.1"
  },
  "peerDependencies": {
    "@flowkit/storage-memory": "workspace:^",
    "vitest": ">=3",
    "zod": "^4"
  },
  "peerDependenciesMeta": {
    "@flowkit/storage-memory": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "@flowkit/storage-memory": "workspace:*",
    "vitest": "5.0.0",
    "zod": "4.6.5"
  }
}
