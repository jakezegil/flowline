{
  "name": "@flowlinejs/storage-memory",
  "version": "0.3.0",
  "type": "module",
  "license": "MIT",
  "description": "In-memory StorageAdapter for the Flowline engine, for tests and quick starts.",
  "keywords": [
    "workflow",
    "automation",
    "workflow-builder",
    "storage",
    "in-memory"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jakezegil/flowline.git",
    "directory": "packages/storage-memory"
  },
  "homepage": "https://github.com/jakezegil/flowline/tree/main/packages/storage-memory#readme",
  "bugs": "https://github.com/jakezegil/flowline/issues",
  "engines": {
    "node": ">=20.18.1"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "flowline-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsup"
  },
  "dependencies": {
    "@flowlinejs/engine": "workspace:^",
    "@flowlinejs/core": "workspace:^"
  },
  "devDependencies": {
    "vitest": "5.0.0",
    "zod": "4.6.5"
  },
  "peerDependencies": {
    "zod": "^4"
  }
}
