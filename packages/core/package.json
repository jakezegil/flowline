{
  "name": "@flowlinejs/core",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "description": "Framework-agnostic core for defining Flowline workflow nodes and plugins, and for building, validating and rendering workflow documents.",
  "keywords": [
    "workflow",
    "automation",
    "workflow-builder",
    "workflow-engine",
    "zod"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jakezegil/flowline.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/jakezegil/flowline/tree/main/packages/core#readme",
  "bugs": "https://github.com/jakezegil/flowline/issues",
  "engines": {
    "node": ">=20.18.1"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "flowline-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "flowline-source": "./src/client.ts",
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./client": {
        "types": "./dist/client.d.ts",
        "default": "./dist/client.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsup"
  },
  "peerDependencies": {
    "zod": "^4"
  },
  "devDependencies": {
    "zod": "4.6.5"
  }
}
