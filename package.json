{
  "name": "flowline",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.5.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "test:scripts": "vitest run --root scripts",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "build": "pnpm -r build",
    "format": "biome format --write .",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && node scripts/release.mjs publish",
    "release:dry-run": "pnpm build && node scripts/release.mjs publish --dry-run"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@changesets/cli": "3.0.3",
    "@types/node": "22.20.2",
    "jsdom": "30.0.1",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vitest": "5.0.0"
  }
}
